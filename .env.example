# Sakho environment. Copy to .env.local for local development.
# Never commit real values. Nothing here is exposed to the browser: the app
# uses NO NEXT_PUBLIC_* variables, so one image can serve demo and live.

# --- Gemini (server only) -------------------------------------------------
# Required for real chat answers. Without it /api/chat returns 503
# provider_unavailable and the rest of the app keeps working.
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Google Cloud Text-to-Speech (server only) ----------------------------
# "true" enables cloud speech using Application Default Credentials
# (the attached service account on Cloud Run; `gcloud auth application-default
# login` locally). Anything else: /api/tts returns 503 and the browser voice
# is used when one exists.
TTS_ENABLED=false
# When TTS_ENABLED is not "true" and GEMINI_API_KEY is set, speech comes from a
# Gemini speech model instead, using the same key. Optional overrides:
# Free-tier keys allow only about 10 speech requests a minute per model; the
# app falls back across Gemini speech models and reuses audio where it can.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Kore is a female voice. The same voice is used for every language.
GEMINI_TTS_VOICE=Kore

# Which voice is tried first when something is read aloud.
# "device" (default): the phone's own voice when it has one for the language.
#   Instant, free, unlimited, works offline. Falls back to the speech service.
# "cloud": the speech service first (one consistent female voice everywhere).
#   Use this only with a paid Gemini tier or Cloud Text-to-Speech: the free
#   Gemini tier allows about 10 speech requests per day per model.
SPEECH_PREFERENCE=device

# --- Emergency mode --------------------------------------------------------
# "live" renders real tel: links. ANY other value (or unset) is demo mode:
# no tel: links exist in the page. Read at request time, not build time.
SOS_MODE=demo

# --- Abuse and cost controls ----------------------------------------------
# Per-client requests per minute for each paid endpoint.
RATE_LIMIT_PER_MINUTE=12
# Total paid-provider requests per UTC day before endpoints return 503.
DAILY_PAID_REQUEST_CAP=2000
# Optional shared counter store (Upstash-compatible Redis REST API). Without
# these, limits are enforced PER INSTANCE only.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Trusted proxies in front of the app that append to X-Forwarded-For.
# 0 = direct Cloud Run. 1 = behind one external HTTPS load balancer.
TRUSTED_PROXY_HOPS=0

# --- Testing / demos -------------------------------------------------------
# "true" replaces Gemini and Cloud TTS with deterministic local mocks.
# Used by Playwright and the Docker smoke test. Never set in production.
SAKHO_MOCK_PROVIDERS=false
